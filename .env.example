# --- Required ---
# Supabase > Project settings > Database > Connection string (use the "Transaction pooler" URL on Vercel)
DATABASE_URL=postgres://postgres:password@localhost:5432/potties
# Long random string used to sign login cookies. Generate with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string
# Public address of the app, e.g. https://orders.potties.co.za
APP_URL=http://localhost:3000

# --- Shopify: app made in the Dev Dashboard (Shopify admin > Settings > Apps > Develop apps) ---
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Only if you have an OLD custom app with a permanent shpat_ token (leave empty otherwise)
SHOPIFY_ADMIN_TOKEN=
# Signing key shown under Settings > Notifications > Webhooks (if you add webhooks there)
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_API_VERSION=2026-07

# --- File storage (Supabase > Storage). Leave empty to store files on local disk (development only) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=fulfilment

# --- Email notifications via Resend (optional). Leave empty to skip emails ---
RESEND_API_KEY=
EMAIL_FROM=Potties Orders <orders@potties.co.za>
HQ_NOTIFY_EMAIL=pottiespots@gmail.com
FOUNDRY_NOTIFY_EMAIL=
# Purchase orders to LL Manufacturing are emailed here
LL_ORDER_EMAIL=

# --- Rules ---
# Days from order to courier pickup when HQ hasn't set a date
DEFAULT_LEAD_DAYS=7
# Hours the foundry has to accept a new order
ACCEPT_WINDOW_HOURS=24
# true = foundry cannot add tracking until HQ approves the proof photos
REQUIRE_HQ_PROOF_APPROVAL=false
# Secret for the scheduled reminder job (Vercel Cron sends it as a Bearer token)
CRON_SECRET=
